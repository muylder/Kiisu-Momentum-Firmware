Import("ENV")


ENV.AppendUnique(
    CFLAGS=[
        "-std=gnu2x",
        "-Wstrict-prototypes",
    ],
    CXXFLAGS=[
        "-std=c++20",
        "-fno-rtti",
        "-fno-use-cxa-atexit",
        "-fno-exceptions",
        "-fno-threadsafe-statics",
        "-ftemplate-depth=512",  # Reduced from 4096 to save memory
        "--param=ggc-min-expand=20",  # Garbage collector tuning for low memory
        "--param=ggc-min-heapsize=4096",  # Minimum heap size
    ],
    CCFLAGS=[
        "-mcpu=cortex-m4",
        "-mfloat-abi=hard",
        "-mfpu=fpv4-sp-d16",
        "-mthumb",
        # "-MMD",
        # "-MP",
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-error=deprecated-declarations",
        "-Wno-address-of-packed-member",
        "-Wredundant-decls",
        "-Wdouble-promotion",
        "-Wundef",
        "-fdata-sections",
        "-ffunction-sections",
        "-Wa,-gdwarf-sections",
        "-fsingle-precision-constant",
        "-fno-math-errno",
        "-fno-strict-aliasing",  # Fix strict-aliasing errors in STM32 HAL
        # Generates .su files with stack usage information
        # "-fstack-usage",
        "-g",
    ],
    CPPDEFINES=[
        "_GNU_SOURCE",
        *GetOption("extra_defines"),
    ],
    LINKFLAGS=[
        "-mcpu=cortex-m4",
        "-mfloat-abi=hard",
        "-mfpu=fpv4-sp-d16",
        "-mlittle-endian",
        "-mthumb",
        "-Wl,--no-warn-rwx-segment",
        # Link-time optimization flags
        "-Wl,--gc-sections",  # Remove unused sections
        "-Wl,--print-memory-usage",  # Print memory usage
    ],
)

# Apply LTO if enabled
if ENV.get("LTO", 0):
    ENV.AppendUnique(
        CCFLAGS=["-flto"],
        LINKFLAGS=["-flto"],
    )

# Apply aggressive optimizations if OPTIMIZATION_LEVEL >= 2
if ENV.get("OPTIMIZATION_LEVEL", 0) >= 2:
    ENV.AppendUnique(
        CCFLAGS=[
            "-ffast-math",  # Aggressive math optimizations
            "-funroll-loops",  # Unroll loops for speed
        ],
    )
